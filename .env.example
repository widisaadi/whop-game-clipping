# ==============================================================================
# Whop Game Clipping Pipeline - Environment Configuration
# ==============================================================================
# Salin file ini menjadi `.env` dan isi dengan API key Anda sendiri.
# JANGAN PERNAH meng-commit file `.env` ke repositori git!
# ==============================================================================

# Google Gemini API Key (Wajib untuk TTS Voiceover & Dynamic Alignment)
# Dapatkan API key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Opsional) Karakter Suara Gemini TTS (Default: Kore | Alternatif: Fenrir, Charon, Zephyr)
# GEMINI_VOICE=Kore

# (Opsional) Rotasi Multi-Key untuk Batch Rendering Skala Besar
# Masukkan beberapa key yang dipisahkan koma untuk mencegah rate limit
GEMINI_API_KEYS=your_first_key_here,your_second_key_here

# (Opsional) Skill Integrasi YouTube / Social Publishing (Publora & Apify)
# PUBLORA_API_KEY=sk_your_publora_key_here
# YOUTUBE_PLATFORM_ID=youtube-UCxxxxxxxxxxxxxxxxxxxxxx
# APIFY_TOKEN=apify_api_your_token_here
